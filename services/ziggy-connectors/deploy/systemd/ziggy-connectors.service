[Unit]
Description=Ziggy tenant connector service
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ziggy-connectors
Group=ziggy-connectors
LoadCredential=google-client-secret:/etc/ziggy/secrets/google-client-secret
LoadCredential=state-signing-key:/etc/ziggy/secrets/connectors-state-signing-key
LoadCredential=token-encryption-key:/etc/ziggy/secrets/connectors-token-encryption-key
LoadCredential=connector-trust-key:/etc/ziggy/secrets/connector-trust-key
LoadCredential=database-url:/etc/ziggy/secrets/connectors-database-url
Environment=ZIGGY_CONNECTORS_GOOGLE_CLIENT_SECRET_FILE=%d/google-client-secret
Environment=ZIGGY_CONNECTORS_STATE_SIGNING_KEY_FILE=%d/state-signing-key
Environment=ZIGGY_CONNECTORS_TOKEN_ENCRYPTION_KEY_FILE=%d/token-encryption-key
Environment=ZIGGY_CONNECTORS_TRUST_KEY_FILE=%d/connector-trust-key
Environment=ZIGGY_CONNECTORS_DATABASE_URL_FILE=%d/database-url
EnvironmentFile=/etc/ziggy/ziggy-connectors.env
ExecStart=/usr/local/bin/ziggy-connectors
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ziggy-connectors

[Install]
WantedBy=multi-user.target
