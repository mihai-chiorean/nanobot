ZIGGY_CONNECTORS_ENV=development
ZIGGY_CONNECTORS_LISTEN_ADDR=127.0.0.1:8790
ZIGGY_CONNECTORS_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
ZIGGY_CONNECTORS_GOOGLE_REDIRECT_URI=http://127.0.0.1:8790/oauth/google/callback
ZIGGY_CONNECTORS_GOOGLE_CLIENT_SECRET_FILE=/run/secrets/ziggy-connectors/google-client-secret
ZIGGY_CONNECTORS_STATE_SIGNING_KEY_FILE=/run/secrets/ziggy-connectors/state-signing-key
ZIGGY_CONNECTORS_TOKEN_ENCRYPTION_KEY_FILE=/run/secrets/ziggy-connectors/token-encryption-key
ZIGGY_CONNECTORS_TRUST_KEY_FILE=/run/secrets/ziggy-connectors/private-gateway-trust-key
# Optional locally; required in production.
ZIGGY_CONNECTORS_DATABASE_URL_FILE=/run/secrets/ziggy-connectors/database-url
