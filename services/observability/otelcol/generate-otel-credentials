#!/bin/sh
set -eu

secret_dir=${1:-/etc/ziggy/secrets}
if [ "$(id -u)" -ne 0 ]; then
  echo "this command must run as root" >&2
  exit 1
fi
for command in openssl htpasswd install; do
  if ! command -v "${command}" >/dev/null 2>&1; then
    echo "required command is unavailable: ${command}" >&2
    exit 1
  fi
done

tmp="$(mktemp -d)"
trap 'rm -rf "${tmp}"' EXIT HUP INT TERM
umask 077
password="$(openssl rand -hex 32)"
printf '%s\n' "${password}" | htpasswd -ciB "${tmp}/otel-local-users.htpasswd" ziggy-control >/dev/null
printf 'ziggy-control:%s\n' "${password}" > "${tmp}/otel-local-auth"
unset password

install -o root -g root -m 0700 -d "${secret_dir}"
install -o root -g root -m 0400 \
  "${tmp}/otel-local-users.htpasswd" "${secret_dir}/otel-local-users.htpasswd"
install -o root -g root -m 0400 \
  "${tmp}/otel-local-auth" "${secret_dir}/otel-local-auth"
echo "installed otel-local-users.htpasswd and otel-local-auth in ${secret_dir}"
