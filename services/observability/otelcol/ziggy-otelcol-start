#!/bin/sh
set -eu

: "${CREDENTIALS_DIRECTORY:?systemd credential directory is unavailable}"
: "${GRAFANA_CLOUD_INSTANCE_ID:?Grafana Cloud instance ID is unavailable}"
: "${GRAFANA_CLOUD_OTLP_ENDPOINT:?Grafana Cloud OTLP endpoint is unavailable}"

grafana_credential="${CREDENTIALS_DIRECTORY}/grafana-cloud-api-key"
if [ ! -s "${grafana_credential}" ]; then
  echo "Grafana Cloud API key credential is unavailable or empty" >&2
  exit 1
fi

GRAFANA_CLOUD_API_KEY_FILE="${grafana_credential}"
ZIGGY_OTLP_HTPASSWD_FILE="${CREDENTIALS_DIRECTORY}/otel-local-users"
HOSTNAME="$(hostname)"

export GRAFANA_CLOUD_API_KEY_FILE ZIGGY_OTLP_HTPASSWD_FILE HOSTNAME
exec /usr/local/bin/otelcol-contrib "$@"
