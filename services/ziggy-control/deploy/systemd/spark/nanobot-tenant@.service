[Unit]
Description=Ziggy tenant Nanobot runtime %i
After=anti-sycophancy-proxy.service network-online.target
Wants=network-online.target
Requires=anti-sycophancy-proxy.service

[Service]
Type=simple
WorkingDirectory=/home/mihai/workspace/ziggy/current-nanobot
ExecStartPre=/usr/bin/curl --fail --silent --show-error http://127.0.0.1:8001/health
ExecStartPre=/usr/bin/curl --fail --silent --show-error --cacert /etc/ssl/certs/ca-certificates.crt https://127.0.0.1:8790/readyz
ExecStart=/home/mihai/workspace/ziggy/.venv/bin/python3 -m nanobot gateway --config /home/mihai/.local/share/ziggy/tenants/%i/runtime/config.json
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/home/mihai/.config/ziggy/tenants/%i.env
LoadCredential=mcp-client-secret:ziggy-mcp-%i
Environment=ZIGGY_MCP_CLIENT_SECRET_FILE=%d/mcp-client-secret
Environment=SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
UnsetEnvironment=CLERK_SECRET_KEY CLERK_SECRET_KEY_FILE
Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s
TimeoutStopSec=30s

NoNewPrivileges=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/mihai/.local/share/ziggy/tenants/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
RestrictSUIDSGID=true
MemoryHigh=768M
MemoryMax=1G
TasksMax=256
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=nanobot-tenant-%i

[Install]
WantedBy=default.target
