[Unit]
Description=Ziggy control front door
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ziggy-control
Group=ziggy-control
LoadCredential=clerk-secret-key:/etc/ziggy/secrets/clerk-secret-key
EnvironmentFile=/etc/ziggy/ziggy-control.env
Environment=CLERK_SECRET_KEY=
Environment=CLERK_SECRET_KEY_FILE=%d/clerk-secret-key
Environment=ZIGGY_OTEL_AUTH_FILE=
Environment=ZIGGY_CONNECTORS_TRUST_KEY_FILE=
Environment=ZIGGY_WORK_TRUST_KEY_FILE=
StateDirectory=ziggy-control
StateDirectoryMode=0700
ExecStart=/usr/local/bin/ziggy-control
Restart=on-failure
RestartSec=2s
# The process shares its 10s application shutdown budget between HTTP drain
# and telemetry flush; keep a 5s cushion before systemd force-kills it.
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ziggy-control

[Install]
WantedBy=multi-user.target
