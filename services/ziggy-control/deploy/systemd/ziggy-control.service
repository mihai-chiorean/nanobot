[Unit]
Description=Ziggy control front door
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ziggy-control
Group=ziggy-control
LoadCredential=clerk-secret-key:/etc/ziggy/secrets/clerk-secret-key
LoadCredential=otel-local-auth:/etc/ziggy/secrets/otel-local-auth
Environment=CLERK_SECRET_KEY_FILE=%d/clerk-secret-key
Environment=ZIGGY_OTEL_AUTH_FILE=%d/otel-local-auth
EnvironmentFile=/etc/ziggy/ziggy-control.env
ExecStart=/usr/local/bin/ziggy-control
Restart=on-failure
RestartSec=2s
TimeoutStopSec=15s

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ziggy-control

[Install]
WantedBy=multi-user.target
