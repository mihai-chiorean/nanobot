# Choose exactly one for local runs. The systemd unit supplies the file path
# through LoadCredential and this file should contain neither setting.
# CLERK_SECRET_KEY=sk_test_replace_me
CLERK_SECRET_KEY_FILE=/absolute/path/to/clerk-secret-key
ZIGGY_OWNER_EMAIL=owner@example.com
ZIGGY_UPSTREAM_URL=http://127.0.0.1:8765
ZIGGY_TENANTS_FILE=/etc/ziggy/tenants.json
ZIGGY_TENANT_BINDINGS_FILE=/var/lib/ziggy-control/tenant-bindings.json

# Optional hard pin in addition to the owner email.
ZIGGY_OWNER_SUBJECT=

# Comma-separated Clerk authorized-party claim values. Leave empty only when
# the native client does not emit an azp claim yet. Production requires this.
ZIGGY_AUTHORIZED_PARTIES=

ZIGGY_LISTEN_ADDR=127.0.0.1:8787
ZIGGY_BLOCKED_PATHS=/webui/bootstrap,/auth/token
ZIGGY_SHUTDOWN_TIMEOUT=10s
ZIGGY_UPSTREAM_READY_TIMEOUT=2s
ZIGGY_UPSTREAM_READY_CACHE_TTL=2s
ZIGGY_UPSTREAM_READY_PATH=/
ZIGGY_MAX_REQUEST_BODY_BYTES=67108864
ZIGGY_MAX_HTTP_IN_FLIGHT=64
ZIGGY_MAX_SSE_IN_FLIGHT=8
ZIGGY_MAX_WEBSOCKET_IN_FLIGHT=8
# Production cannot disable the owner-only legacy route preflight. Development
# may set this false when using an incompatible checked-in Nanobot build.
ZIGGY_LEGACY_UPSTREAM_PREFLIGHT=true
ZIGGY_LOG_LEVEL=info

# Optional. Both values are required to enable application telemetry.
# ziggy-control accepts only a loopback OTLP/HTTP collector endpoint. The auth
# file is a systemd client credential containing one "username:password" value;
# Beelink uses "ziggy-control:<plain random password>". It is not the collector's
# separate htpasswd file and is not a Grafana credential.
ZIGGY_OTEL_ENDPOINT=
ZIGGY_OTEL_AUTH_FILE=
ZIGGY_OTEL_TRACE_SAMPLE_RATIO=1.0
ZIGGY_DEPLOYMENT_ENVIRONMENT=production

# Optional private Gmail connector service. The systemd unit supplies the trust
# key credential automatically. Set the file explicitly outside systemd.
ZIGGY_CONNECTORS_URL=http://127.0.0.1:8790
ZIGGY_CONNECTORS_TRUST_KEY_FILE=
