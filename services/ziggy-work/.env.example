ZIGGY_WORK_ENV=development
ZIGGY_WORK_VERSION=dev
ZIGGY_WORK_LISTEN_ADDR=127.0.0.1:8791
ZIGGY_WORK_DATABASE_URL_FILE=/etc/ziggy/secrets/work-database-url
ZIGGY_WORK_TRUST_KEY_FILE=/etc/ziggy/secrets/work-trust-key
ZIGGY_WORK_TENANTS_FILE=/etc/ziggy/secrets/work-runtimes.json
ZIGGY_WORK_ARTIFACT_ROOT=/var/lib/ziggy-work/artifacts
ZIGGY_WORK_QUEUE=ziggy_work_low
ZIGGY_WORK_QUEUE_WORKERS=2
ZIGGY_WORK_QUEUE_CAPACITY=256
ZIGGY_WORK_STREAM_LIMIT=100
ZIGGY_WORK_TENANT_STREAM_LIMIT=4
# Optional. Empty/unset keeps reconciliation off.
# ZIGGY_WORK_RECONCILE_INTERVAL=60s
# Optional loopback OTLP/HTTP collector, for example 127.0.0.1:4318.
# ZIGGY_WORK_OTLP_HTTP_ENDPOINT=127.0.0.1:4318
