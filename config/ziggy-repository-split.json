{
  "schema": 2,
  "name": "ziggy-product-repository",
  "source": {
    "base_ref": "origin/feat/ziggy-ios",
    "working_tree_policy": "clean_required",
    "tracked_files_only": true
  },
  "nanobot_dependency": {
    "upstream_baseline": {
      "package": "nanobot-ai",
      "repository": "https://github.com/HKUDS/nanobot.git",
      "ref": "v0.1.5.post3",
      "commit": "0b1631f33d8040802aa09d66a01bc731e3cb85a2",
      "pin_options": ["commit", "tag", "artifact_digest"]
    },
    "effective_runtime_policy": {
      "pre_artifact_kind": "source-export",
      "artifact": {
        "image": null,
        "digest": null,
        "wheel": null
      }
    },
    "update_rule": "advance the upstream baseline and effective runtime together; rerun the product contract tests before merging"
  },
  "entries": [
    {"source_prefix": "ios", "destination_prefix": "ios", "required": true},
    {"source_prefix": "webui", "destination_prefix": "web", "exclude": ["webui/vite.config.ts"], "required": true},
    {
      "source": "webui/vite.config.ts",
      "destination": "web/vite.config.ts",
      "text_replacements": [
        {
          "from": "path.resolve(__dirname, \"../nanobot/web/dist\")",
          "to": "path.resolve(__dirname, \"./dist\")"
        }
      ],
      "required": true
    },
    {"source_prefix": "bridge", "destination_prefix": "web/bridge", "required": true},
    {"source_prefix": "services/ziggy-control", "destination_prefix": "services/ziggy-control", "required": true},
    {"source_prefix": "services/ziggy-connectors", "destination_prefix": "services/ziggy-connectors", "required": true},
    {"source_prefix": "services/ziggy-runtime-manager", "destination_prefix": "services/ziggy-runtime-manager", "required": true},
    {"source_prefix": "services/ziggy-work", "destination_prefix": "services/ziggy-work", "required": true},
    {"source_prefix": "services/observability", "destination_prefix": "observability", "required": true},
    {"source_prefix": "docs/architecture/ziggy-", "destination_prefix": "docs/architecture", "required": true},
    {"source_prefix": "docs/runbooks", "destination_prefix": "docs/runbooks", "required": true},
    {"source_prefix": "docs/research", "destination_prefix": "docs/research", "required": true},
    {"source_prefix": "docs/reviews/ziggy-", "destination_prefix": "docs/reviews", "required": true},
    {"source_prefix": "config/ziggy-repository-split.json", "destination_prefix": "config/ziggy-repository-split.json", "required": true},
    {"source_prefix": "scripts/export-ziggy-product.sh", "destination_prefix": "scripts/export-ziggy-product.sh", "required": true},
    {"source_prefix": "scripts/validate-ziggy-product-split.py", "destination_prefix": "scripts/validate-ziggy-product-split.py", "required": true},
    {"source_prefix": "scripts/test-ziggy-product-split.sh", "destination_prefix": "scripts/test-ziggy-product-split.sh", "required": true},
    {"source_prefix": "scripts/assert-ziggy-web-build.sh", "destination_prefix": "scripts/assert-ziggy-web-build.sh", "required": true},
    {"source": "LICENSE", "destination": "licenses/nanobot-MIT.txt", "required": true},
    {"source": "THIRD_PARTY_NOTICES.md", "destination": "licenses/nanobot-third-party-notices.md", "required": true}
  ],
  "generated": [
    {"destination": "README.md", "kind": "product_readme"},
    {"destination": ".gitignore", "kind": "product_gitignore"},
    {"destination": "LICENSE", "kind": "license_index"},
    {"destination": "THIRD_PARTY_NOTICES.md", "kind": "third_party_index"},
    {"destination": "deploy/README.md", "kind": "deploy_index"},
    {"destination": "runbooks/README.md", "kind": "runbooks_index"},
    {"destination": "research/README.md", "kind": "research_index"},
    {"destination": ".github/workflows/ziggy-product.yml", "kind": "product_ci"},
    {"destination": ".ziggy/export-metadata.json", "kind": "export_metadata"},
    {"destination": ".ziggy/nanobot.lock.json", "kind": "nanobot_lock"}
  ],
  "validation": {
    "required_output_paths": [
      "ios",
      "web",
      "services/ziggy-control",
      "services/ziggy-connectors",
      "services/ziggy-runtime-manager",
      "services/ziggy-work",
      "observability",
      "deploy",
      "docs/architecture",
      "docs/runbooks",
      "docs/research",
      "licenses",
      ".github/workflows/ziggy-product.yml",
      ".ziggy/export-metadata.json",
      ".ziggy/nanobot.lock.json"
    ],
    "required_output_text": [
      {
        "path": "web/vite.config.ts",
        "contains": "path.resolve(__dirname, \"./dist\")",
        "absent": "../nanobot/web/dist"
      },
      {
        "path": "LICENSE",
        "contains": "No license is granted",
        "absent": "Permission is hereby granted"
      }
    ],
    "forbidden_output_prefixes": [
      "nanobot",
      "tests",
      "webui",
      "pyproject.toml",
      "uv.lock",
      "Dockerfile",
      "docker-compose.yml",
      "entrypoint.sh",
      "core_agent_lines.sh",
      "case",
      "images",
      "root-fork-copy"
    ],
    "secret_filename_patterns": [
      "(^|/)\\.env$",
      "\\.pem$",
      "\\.p12$",
      "\\.key$",
      "(^|/)(credentials|secrets?)(\\.|/|$)"
    ],
    "secret_content_max_file_bytes": 524288,
    "secret_content_max_total_bytes": 16777216,
    "secret_content_patterns": [
      {
        "id": "private-key-header",
        "regex": "-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----"
      },
      {
        "id": "grafana-cloud-token",
        "regex": "(?<![A-Za-z0-9_-])glc_[A-Za-z0-9_-]{32,128}(?![A-Za-z0-9_-])"
      },
      {
        "id": "stripe-secret-token",
        "regex": "(?<![A-Za-z0-9_-])sk_(?:live|test)_[A-Za-z0-9]{24,128}(?![A-Za-z0-9_-])"
      },
      {
        "id": "google-api-key",
        "regex": "(?<![A-Za-z0-9_-])AIza[0-9A-Za-z_-]{35}(?![A-Za-z0-9_-])"
      }
    ],
    "secret_content_exempt_path_patterns": [
      "(^|/)(?:node_modules|dist|coverage|\\.vite|bin)(/|$)"
    ]
  },
  "patches": [
    {
      "id": "web-branding-dist",
      "area": "web branding and packaged frontend",
      "classification": "product-boundary",
      "removal_order": 0,
      "current_commits": ["89815b71", "479882fe"],
      "paths": ["nanobot/web/dist", "pyproject.toml"],
      "action": "keep the PWA and branding in web/; consume Nanobot as a runtime and never export nanobot/web/dist"
    },
    {
      "id": "runtime-tenant-auth-transport",
      "area": "auth token broker and transport",
      "classification": "product-boundary",
      "removal_order": 1,
      "current_commits": ["a183956f", "89815b71", "479882fe", "3fdedbea", "92823268"],
      "paths": ["nanobot/security/clerk.py", "nanobot/channels/websocket.py", "nanobot/channels/websocket_server.py", "nanobot/cli/commands.py"],
      "action": "move Clerk verification, tenant admission, and token issuance to ziggy-control; retain only a generic runtime transport contract"
    },
    {
      "id": "work-hooks",
      "area": "durable Work lifecycle hooks",
      "classification": "product-boundary",
      "removal_order": 2,
      "current_commits": ["55683729", "89815b71", "479882fe"],
      "paths": ["nanobot/work", "nanobot/agent/tools/work.py", "nanobot/agent/tools/schedule_work.py", "nanobot/channels/websocket.py", "nanobot/agent/loop.py"],
      "action": "make ziggy-work the durable owner and reduce the runtime integration to a versioned event/command adapter"
    },
    {
      "id": "mcp-oauth-client-credentials",
      "area": "MCP OAuth support",
      "classification": "upstreamable",
      "removal_order": 3,
      "current_commits": ["4addeb38", "145cec6f", "6972981c"],
      "paths": ["nanobot/agent/tools/mcp.py", "nanobot/config/schema.py"],
      "action": "upstream generic client-credentials/token-endpoint configuration; keep tenant credential storage in ziggy-connectors"
    },
    {
      "id": "memory-tenant-scope",
      "area": "memory and RAG tenant isolation",
      "classification": "product-boundary",
      "removal_order": 4,
      "current_commits": ["2343f7c3", "ac1fe757"],
      "paths": ["nanobot/agent/loop.py", "nanobot/agent/tools/recall.py", "nanobot/agent/rag.py", "nanobot/config/schema.py"],
      "action": "bind memory roots and recall providers at the per-tenant runtime boundary; upstream the independent path-safety checks"
    },
    {
      "id": "generic-runtime-fixes",
      "area": "generic runtime correctness",
      "classification": "upstreamable",
      "removal_order": 5,
      "current_commits": ["8314f206", "92823268"],
      "paths": ["nanobot/session/manager.py", "nanobot/channels/websocket.py"],
      "action": "submit narrowly scoped tests and fixes upstream, then advance the pinned dependency"
    },
    {
      "id": "patched-runtime-artifact",
      "area": "temporary delivery of not-yet-upstreamed patches",
      "classification": "temporary",
      "removal_order": 6,
      "current_commits": ["d2eb946"],
      "paths": ["nanobot/**"],
      "action": "build a separately pinned Ziggy runtime artifact or patch overlay; do not vendor the full Nanobot tree into the product repository"
    }
  ]
}
